assets/processed/*

# Keep directory placeholders
!inbox/.gitkeep
!output/.gitkeep
!logs/.gitkeep
!assets/raw/.gitkeep
!assets/processed/.gitkeep

# Secrets
.env
.env.*
!.env.example
*.key
*.pem

