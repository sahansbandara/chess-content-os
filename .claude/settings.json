{
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(sed -n:*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git branch*)",
      "Bash(git show*)",
      "Bash(git check-ignore:*)",
      "Bash(git ls-files*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(bash .claude/hooks/git-sync-main.sh)",
      "Bash(uv run:*)",
      "Bash(uv add:*)",
      "Bash(uv sync*)",
      "Bash(uv pip list*)",
      "Bash(python --version*)",
      "Bash(python -m pytest*)",
      "Bash(uv run pytest*)",
      "Bash(ffprobe:*)",
      "Bash(ffmpeg -version*)",
      "Bash(stockfish*)",
      "Read",
      "Edit",
      "Write",
      "Agent"
    ],
    "deny": []
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/session-wrap.sh\"",
            "timeout": 20,
            "statusMessage": "Checking post-session wrap-up..."
          }
        ]
      }
    ]
  }
}
